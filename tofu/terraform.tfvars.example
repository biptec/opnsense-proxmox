# Proxmox API endpoint and target node.
proxmox_endpoint = "https://pve01.example.net:8006/"
proxmox_insecure = false
node_name        = "pve01"

# VM identity. Omit vm_id to let Proxmox allocate the next free ID.
vm_name = "opnsense-test"
# vm_id = 104

# Image mode A: upload a local image from the OpenTofu runner.
image_source    = "local"
image_datastore = "local"
image_path      = "./OPNsense.qcow2"
# image_sha256  = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Image mode B: use an image already uploaded to Proxmox.
# Comment the four local-mode values above and enable these two values:
# image_source  = "proxmox"
# image_file_id = "local:import/OPNsense.qcow2"

# VM disk and optional Cloud-Init drive storage.
vm_datastore = "local-vmdata01"
# cloudinit_datastore = "local-vmdata01"

# Management network. Omit management_mac to let Proxmox generate it.
bridge = "vmbr1"

# preserve is the safe default and keeps IPv4 settings already stored in the image.
management_ipv4 = {
  mode = "preserve"
}

# To request DHCP instead:
# management_ipv4 = {
#   mode = "dhcp"
# }

# To apply a static address instead:
# management_ipv4 = {
#   mode    = "static"
#   address = "10.200.0.50/24"
#   gateway = "10.200.0.1"
# }

# management_mac     = "02:00:00:00:50:01"
# management_vlan_id = 100

# Optional guest DNS settings.
dns_servers = ["1.1.1.1"]
dns_domain  = "example.net"

# Optional administrative account. Password and SSH key are independent.
# Store the real password in a gitignored *.auto.tfvars file or TF_VAR variable.
# cloudinit_username  = "proxmox"
# cloudinit_password  = "replace-with-a-strong-password"
# ssh_public_key_path = "./id_ed25519.pub"

# Optional VM hardware and lifecycle settings.
# vm_description       = "Managed by OpenTofu"
# vm_tags              = ["opnsense", "managed"]
# vm_started           = true
# vm_on_boot           = true
# vm_stop_on_destroy   = true
# vm_acpi              = true
# vm_bios              = "seabios"
# vm_machine           = "q35"
# vm_scsi_hardware     = "virtio-scsi-single"
# vm_boot_order        = ["scsi0"]
# vm_protection        = false
# vm_reboot            = false
# vm_hotplug           = "network,disk,usb"
# qemu_agent_enabled    = true
# qemu_agent_type       = "virtio"
# qemu_agent_wait_for_ip = { disabled = true, ipv4 = false, ipv6 = false }
# cores                = 4
# cpu_type             = "host"
# cpu_sockets          = 1
# cpu_numa             = false
# memory_mb            = 4096
# memory_floating_mb   = 0
# disk_interface       = "scsi0"
# disk_size_gb         = 21
# disk_discard         = "on"
# disk_ssd             = true
# network_model         = "virtio"
# management_nic_enabled = true
# management_nic_firewall = false
# operating_system_type = "other"
# serial_device_enabled = true
# serial_device         = "socket"
# cloudinit_interface    = "ide2"
# additional_nics        = []
