# Temporary pre-cutover overlay for the Etna VM bootstrap state.
# Apply this after vm-bootstrap.tfvars so the trunk NIC can reach only the
# VLANs required for Etna/Rigi validation while provider-facing VLAN 3801
# remains physically blocked from the guest.
#
# Do not keep this overlay after the WAN cutover. The final Etna trunk is
# unrestricted so downstream states can add their own VLANs without changing
# the primary VM state.
additional_nics = [
  {
    bridge = "vmbr1"
    trunks = "508;2804;2820;3802"
  }
]
