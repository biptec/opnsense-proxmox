# Etna VM bootstrap values used with the generic ../../tofu VM root.
# This is a separate Terraform state only because the OPNsense API cannot be
# configured until this VM exists and has completed its first boot.
node_name       = "tofana"
vm_name         = "etna"
vm_datastore    = "local-vmdata01"
image_datastore = "local"
bridge          = "vmbr2"
dns_domain      = "host.biptec.net"

# Etna must be available after a Tofana reboot while the host is still in
# persistent rescue mode. wan-cutover never starts or stops the VM itself.
vm_started = true
vm_on_boot = true

management_ipv4 = {
  mode    = "static"
  address = "10.16.214.2/30"
}

# The second VirtIO NIC is the final unrestricted tagged trunk. Do not set
# vlan_id here; VLANs are created inside OPNsense on vtnet1. Before WAN
# cutover, VLAN 3801 is isolated at the provider-facing physical Proxmox NIC,
# which is not configured as access VLAN 3801 until the maintenance window.
additional_nics = [
  {
    bridge      = "vmbr1"
    mac_address = "90:1b:0e:95:a1:0b"
  }
]
