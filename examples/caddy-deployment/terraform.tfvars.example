routes = {
  "www.example.com" = {
    upstream_domains  = ["10.20.0.10"]
    upstream_port     = 8080
    upstream_protocol = "http"
    certificate_mode  = "acme"
    description       = "Public application"
  }

  "service.internal.example.com" = {
    upstream_domains                   = ["10.20.0.20"]
    upstream_port                      = 8443
    upstream_protocol                  = "https"
    certificate_mode                   = "internal"
    internal_ca_name                   = "internal.example.com"
    internal_certificate_lifetime_days = 3650
    allowed_networks                   = ["10.0.0.0/8"]
    upstream_tls_server_name           = "service.internal.example.com"
    unbound_address                    = "10.40.0.10"
    description                        = "Internal application"
  }
}
