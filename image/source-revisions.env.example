# Copy to image/source-revisions.env and fill every value with the exact
# 40-character lowercase commit checked out in the build environment.

TOOLS_COMMIT=${TOOLS_COMMIT:-}
CORE_COMMIT=${CORE_COMMIT:-}
PLUGINS_COMMIT=${PLUGINS_COMMIT:-}
PORTS_COMMIT=${PORTS_COMMIT:-}
SRC_COMMIT=${SRC_COMMIT:-}

# Branch names must match the checked-out branches at the commits above.
TOOLSBRANCH=${TOOLSBRANCH:-master}
COREBRANCH=${COREBRANCH:-master}
PLUGINSBRANCH=${PLUGINSBRANCH:-master}
PORTSBRANCH=${PORTSBRANCH:-master}
SRCBRANCH=${SRCBRANCH:-master}
